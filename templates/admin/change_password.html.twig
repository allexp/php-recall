{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Смена пароля{% endblock %}

{% block main %}
    <div class="content-panel">
        <div class="content-panel-body with-background without-header without-footer">
            {% for error in errors %}
                <div class="alert alert-danger" role="alert">{{ error }}</div>
            {% endfor %}

            <form method="post" class="ea-new-form">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_change_password') }}">

                <div class="form-group">
                    <label class="form-control-label required" for="current-password">Текущий пароль</label>
                    <div class="form-widget">
                        <input class="form-control" id="current-password" name="current_password" type="password" autocomplete="current-password" required autofocus>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-control-label required" for="new-password">Новый пароль</label>
                    <div class="form-widget">
                        <input class="form-control" id="new-password" name="new_password" type="password" minlength="12" autocomplete="new-password" required>
                        <p class="help-text">Не менее 12 символов.</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-control-label required" for="password-confirmation">Повторите новый пароль</label>
                    <div class="form-widget">
                        <input class="form-control" id="password-confirmation" name="password_confirmation" type="password" minlength="12" autocomplete="new-password" required>
                    </div>
                </div>

                <button class="btn btn-primary action-save" type="submit">Сохранить новый пароль</button>
            </form>
        </div>
    </div>
{% endblock %}
