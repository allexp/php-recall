<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Тренажёр для изучения функций PHP">
    <title>PHP Recall — тренажёр функций</title>
    <link rel="stylesheet" href="app.css">
</head>
<body data-authenticated="{{ app.session.get('user') ? '1' : '0' }}" data-knowledge-token="{{ knowledge_token }}" data-sandbox-token="{{ sandbox_token }}">
    <header class="topbar">
        <a class="brand" href="./" aria-label="PHP Recall — на главную">
            <span class="brand-mark">&lt;?php</span>
            <span>Recall</span>
        </a>
        <nav class="content-switch" aria-label="Раздел обучения">
            <button class="switch-button active" id="functions-mode" type="button">PHP-функции</button>
            <button class="switch-button" id="concepts-mode" type="button">Концепции</button>
            <button class="switch-button" id="sandbox-mode" type="button">Песочница</button>
        </nav>
        <label class="category-picker" id="category-picker">
            <span>Категория</span>
            <select id="category" aria-label="Категория функций">
                <option value="all">Все функции</option>
            </select>
        </label>
        <div class="topbar-account">
            <div class="progress" id="progress">Загрузка…</div>
            {% if app.session.get('user') %}
                <span class="user-email">{{ app.session.get('user').email }}</span>
                <form method="post" action="{{ path('app_logout') }}">
                    <input type="hidden" name="_token" value="{{ logout_token }}">
                    <button class="link-button" type="submit">Выйти</button>
                </form>
            {% else %}
                <a class="account-link" href="{{ path('app_login') }}">Войти</a>
                <a class="account-link account-link-primary" href="{{ path('app_register') }}">Регистрация</a>
            {% endif %}
        </div>
    </header>

    <main class="stage" id="stage">
        <button class="nav-button nav-prev" id="previous" type="button" aria-label="Предыдущая функция" disabled>←</button>

        <div class="content-column">
            <article class="card" id="study-card" aria-live="polite">
                <div class="quiz-mode" id="quiz-mode" role="group" aria-label="Режим карточек функций">
                    <button class="quiz-mode-button active" id="quiz-by-name" type="button" aria-pressed="true">По названию</button>
                    <button class="quiz-mode-button" id="quiz-by-definition" type="button" aria-pressed="false">По определению</button>
                </div>
                <div class="eyebrow" id="category-label">Функция PHP</div>
                <h1 id="function-name">…</h1>
                <p class="question-definition hidden" id="question-definition"></p>
                <p class="prompt" id="prompt">Вспомните, что делает эта функция.</p>

                <div class="actions">
                    <button class="primary" id="reveal" type="button">Показать</button>
                    <button class="known" id="known" type="button">Знаю</button>
                </div>

                <div class="loading hidden" id="loading">Загружаю документацию…</div>
                <div class="error hidden" id="error"></div>
                <section class="answer hidden" id="answer"></section>
                <section class="manual hidden" id="manual"></section>
                <button class="secondary full-button hidden" id="show-full" type="button">Показать полностью</button>
                <a class="source hidden" id="source" target="_blank" rel="noopener noreferrer">Открыть на php.net ↗</a>
            </article>

            <article class="card sandbox-card hidden" id="sandbox-panel">
                <div class="eyebrow">Изолированное выполнение</div>
                <h1 class="sandbox-title">PHP-песочница</h1>
                <p class="prompt">Код запускается без сети и доступа к файлам приложения. Лимит выполнения — 2 секунды.</p>
                <label class="sandbox-label" for="sandbox-code">PHP-код</label>
                <textarea id="sandbox-code" class="sandbox-editor" spellcheck="false" maxlength="20000"><?php

$numbers = [1, 2, 3, 4];
$squares = array_map(fn (int $number): int => $number ** 2, $numbers);

print_r($squares);</textarea>
                <div class="sandbox-toolbar">
                    <button class="primary" id="sandbox-run" type="button">Запустить <span class="shortcut">Ctrl + Enter</span></button>
                    <span class="sandbox-status" id="sandbox-status">Готово к запуску</span>
                </div>
                <section class="sandbox-result hidden" id="sandbox-result" aria-live="polite">
                    <div class="sandbox-result-title">Результат</div>
                    <pre><code id="sandbox-output"></code></pre>
                </section>
                <div class="error hidden" id="sandbox-error"></div>
            </article>

            <aside class="statistics" id="statistics" aria-labelledby="statistics-title">
                <div>
                    <div class="statistics-title" id="statistics-title">Статистика</div>
                    <div class="statistics-hint">Сохраняется в этом браузере</div>
                </div>
                <dl>
                    <div>
                        <dt>Знаю</dt>
                        <dd id="known-count">0</dd>
                    </div>
                    <div>
                        <dt>Показать</dt>
                        <dd id="reveal-count">0</dd>
                    </div>
                </dl>
            </aside>

            {% if app.session.get('user') %}
                <aside class="category-statistics hidden" id="category-statistics" aria-labelledby="category-statistics-title">
                    <div>
                        <div class="statistics-title" id="category-statistics-title">Статистика по категориям</div>
                        <div class="statistics-hint">Функции, которые вы отметили как известные</div>
                    </div>
                    <dl id="category-statistics-list"></dl>
                </aside>
            {% endif %}
        </div>

        <button class="nav-button nav-next" id="next" type="button" aria-label="Следующая случайная функция">→</button>
    </main>

    <footer>Сначала попробуйте ответить сами — узнавание запоминается хуже, чем припоминание.</footer>
    <script src="sandbox-editor.js" defer></script>
    <script src="app.js" defer></script>
</body>
</html>
