{% extends 'auth/base.html.twig' %}
{% block title %}Вход{% endblock %}
{% block content %}
    <h1 class="auth-title">Вход</h1>
    <p class="auth-subtitle">Продолжите изучать функции PHP.</p>
    {% if error %}<div class="form-errors" role="alert"><p>{{ error }}</p></div>{% endif %}
    <form method="post" class="auth-form">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <label>Email<input type="email" name="email" value="{{ email }}" autocomplete="email" required autofocus></label>
        <label>Пароль<input type="password" name="password" autocomplete="current-password" required></label>
        <button class="primary" type="submit">Войти</button>
    </form>
    <p class="auth-switch">Нет аккаунта? <a href="{{ path('app_register') }}">Зарегистрироваться</a></p>
{% endblock %}
